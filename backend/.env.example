# Meta App Dashboard -> App settings -> Basic
META_APP_ID=
META_APP_SECRET=

# WhatsApp -> Configuration -> Embedded Signup configuration ID
META_CONFIG_ID=

# Meta Webhooks verify token for /api/whatsapp/webhook
META_WEBHOOK_VERIFY_TOKEN=

# Graph API version enabled for this Meta app
META_GRAPH_API_VERSION=v23.0

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable and secret. Required to encrypt WhatsApp tokens at rest (64 hex characters).
WHATSAPP_TOKEN_ENCRYPTION_KEY=
